{
  "rules": {
    ".read": false,
    ".write": false,

    "shops": {
      "$shopId": {
        ".read": "auth != null",
        ".write": "auth != null && (!data.child('shop/ownerUid').exists() || data.child('shop/ownerUid').val() === auth.uid)",
        "bookings":  { ".write": "auth != null" },
        "waitlist":  { ".write": "auth != null" },
        "alerts":    { ".write": "auth != null" },
        "reviews":   { ".write": "auth != null" },
        "updatedAt": { ".write": "auth != null" }
      }
    },

    "gallery": {
      "$shopId": {
        ".read": "auth != null",
        ".write": "auth != null"
      }
    },

    "pushTokens": {
      "$uid": {
        ".read": "auth != null",
        ".write": "auth != null"
      }
    },

    "subs": {
      ".read": "auth != null",
      ".write": "auth != null"
    },

    "shopIndex": {
      ".read": "auth != null",
      ".write": "auth != null"
    },

    "passHashes": {
      "$hash": {
        ".read": "auth != null",
        ".write": "auth != null && !data.exists()"
      }
    }
  }
}
